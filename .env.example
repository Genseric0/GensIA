# Optional persistent token: generate a random 32–256 character ASCII alphanumeric
# value and export it in your shell. This file is documentation, not auto-loaded.
# Prefer `gensia-api --ephemeral-token` for a fresh credential per process.
GENSIA_API_TOKEN=

# Configure this on the Ollama server, then restart Ollama before using GensIA.
OLLAMA_NO_CLOUD=1
